# DF Weather Telemetry — Backend environment
# Copy to .env and fill in your own values. NEVER commit a real key.
NODE_ENV=development
PORT=5000

# OpenWeatherMap free API key (https://openweathermap.org/api)
# Leave as the placeholder to run in DEMO mode with seed data.
OPENWEATHER_API_KEY=your_api_key_here

# Upstream behaviour
OPENWEATHER_TIMEOUT_MS=8000
OPENWEATHER_MAX_RETRIES=3

# Comma-separated list of allowed browser origins (no wildcard).
# Add your deployed frontend URL here, e.g. https://df-weather.vercel.app
CORS_ORIGIN=http://localhost:5173

# Rate limits (requests per window, per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_WEATHER_WINDOW_MS=900000
RATE_LIMIT_WEATHER_MAX=30

# Cache + idempotency TTLs (ms)
CACHE_TTL_MS=600000
IDEMPOTENCY_TTL_MS=600000
